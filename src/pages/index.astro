---
const siteName = "James Hawley";
const title = "James Hawley";
const description = "CS & Economics at UVA. Writing on technology, economics, and ideas.";

const rawPosts = await Astro.glob('./posts/*.md');
const allPosts = rawPosts
  .filter((post) => post.frontmatter.visible !== false)
  .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());

const formatDate = (date: string | Date) => {
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <div class="page-wrapper">
      <main>
        <h1 class="name">{siteName}</h1>
        <p class="tagline">CS & Economics at UVA</p>

        <p class="links">
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a> ·
          <a href="https://www.linkedin.com/in/james-m-hawley/" target="_blank" rel="noopener noreferrer">LinkedIn</a> ·
          <a href="mailto:jameshawley@email.virginia.edu">Email</a> ·
          <a href="/about">About</a>
        </p>

        <div class="post-list">
          {allPosts.map((post) => (
            <a href={post.url} class="post-link">
              <span class="post-date">{formatDate(post.frontmatter.pubDate)}</span>
              <span class="post-title">{post.frontmatter.title}</span>
            </a>
          ))}
        </div>
      </main>

      <footer>
        <p>&copy; {new Date().getFullYear()} {siteName}</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f5f0e8;
    --text-primary: #1a1a1a;
    --text-secondary: #3d3d3d;
    --text-muted: #6b6b6b;
    --font-serif: Georgia, 'Times New Roman', Times, serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-primary);
    background-color: var(--cream);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>

<style>
  .page-wrapper {
    animation: fadeIn 0.4s ease-out;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    flex: 1;
  }

  .name {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .tagline {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .links {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .links a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .links a:hover {
    opacity: 0.6;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.375rem 0;
    text-decoration: none;
    color: var(--text-primary);
  }

  .post-link:hover {
    opacity: 1;
  }

  .post-link:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
    min-width: 4.5rem;
  }

  .post-title {
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  footer {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 1.5rem 2.5rem;
    width: 100%;
  }

  footer p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    main {
      padding: 3rem 1.25rem 2rem;
    }

    .name {
      font-size: 1.375rem;
    }

    .post-link {
      flex-direction: column;
      gap: 0.125rem;
    }

    .post-date {
      font-size: 0.75rem;
    }

    .post-title {
      font-size: 0.9375rem;
    }

    footer {
      padding: 0 1.25rem 2rem;
    }
  }
</style>
