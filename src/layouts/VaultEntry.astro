---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  pubDate: Date | string;
  mood?: string;
}

const props = Astro.props as any;
const fm = props.frontmatter || props;
const { title, pubDate, mood } = fm;

let dateObject: Date;
if (!pubDate) {
  dateObject = new Date();
} else if (pubDate instanceof Date) {
  dateObject = pubDate;
} else {
  dateObject = new Date(pubDate);
}

if (isNaN(dateObject.getTime())) {
  dateObject = new Date();
}

const formattedDate = dateObject.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | Vault`} description="Private journal entry">
  <div id="entry-gate" class="entry-gate">
    <div class="gate-container">
      <h1>Protected Entry</h1>
      <p class="gate-message">This journal entry is private and requires vault access to view.</p>
      <a href="/vault" class="vault-link">Unlock Vault &rarr;</a>
    </div>
  </div>

  <article id="entry-content" class="entry">
    <header class="entry-header">
      <a href="/vault" class="back-link">&larr; Back to Vault</a>
      <div class="entry-meta">
        <time datetime={dateObject.toISOString()}>{formattedDate}</time>
        {mood && <span class="mood-tag">{mood}</span>}
      </div>
      <h1>{title}</h1>
    </header>
    <div class="entry-content">
      <slot />
    </div>
    <footer class="entry-footer">
      <a href="/vault" class="back-link">&larr; Back to Vault</a>
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  const gate = document.getElementById('entry-gate');
  const content = document.getElementById('entry-content');

  if (sessionStorage.getItem('vault-unlocked') === 'true') {
    gate.style.display = 'none';
    content.classList.add('visible');
  }
</script>

<style>
  .entry-gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    padding: 3rem 1.5rem;
  }

  .gate-container {
    text-align: center;
    max-width: 400px;
  }

  .gate-container h1 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .gate-message {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .vault-link {
    color: var(--text-primary);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .vault-link:hover {
    opacity: 0.6;
  }

  .entry {
    display: none;
    max-width: 100%;
    opacity: 0;
  }

  .entry.visible {
    display: block;
    animation: fadeIn 0.4s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .entry-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .entry-header time {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .mood-tag {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--cream-dark);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
  }

  .entry-header h1 {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0;
  }

  .entry-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .entry-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .entry-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .entry-content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .entry-content :global(ul),
  .entry-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .entry-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .entry-content :global(blockquote) {
    border-left: 2px solid var(--text-muted);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .entry-content :global(blockquote p) {
    margin-bottom: 0;
  }

  .entry-content :global(code) {
    font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
    font-size: 0.875em;
    background: var(--cream-dark);
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
  }

  .entry-content :global(pre) {
    background: #1a1a1a;
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.75rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .entry-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: #e5e5e5;
  }

  .entry-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 4px;
  }

  .entry-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2.5rem 0;
  }

  .entry-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
</style>
