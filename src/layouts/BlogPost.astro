---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  author?: string;
  category?: 'tech' | 'economics' | 'books' | 'projects' | 'thoughts';
}

const props = Astro.props as any;
const fm = props.frontmatter || props;
const { title, description, pubDate, category } = fm;

const categoryLabels: Record<string, string> = {
  tech: 'Technology',
  economics: 'Economics',
  books: 'Books',
  projects: 'Projects',
  thoughts: 'Essays'
};

const categoryLabel = category ? categoryLabels[category] : null;

let dateObject: Date;
if (!pubDate) {
  dateObject = new Date();
} else if (pubDate instanceof Date) {
  dateObject = pubDate;
} else {
  dateObject = new Date(pubDate);
}

if (isNaN(dateObject.getTime())) {
  dateObject = new Date();
}

const formattedDate = dateObject.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <div class="notch-cover"></div>
  <div class="progress-bar" id="progress-bar"></div>
  <article class="article">
    <header class="article-header">
      <a href="/" class="back-link">&larr; Home</a>
      <h1 class="article-title">{title}</h1>
      <p class="article-meta">
        <time datetime={dateObject.toISOString()}>{formattedDate}</time>
        {categoryLabel && <span class="category-tag">{categoryLabel}</span>}
      </p>
    </header>

    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<script is:inline>
  const bar = document.getElementById('progress-bar');
  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
    bar.style.width = (progress * 100) + '%';
  });
</script>

<style>
  .article {
    max-width: 100%;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .article-meta {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .category-tag {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--cream-dark, #ebe5d9);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  /* Article body typography */
  .article-body {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .article-body :global(h4) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .article-body :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    opacity: 0.6;
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .article-body :global(em) {
    font-style: italic;
  }

  .article-body :global(code) {
    font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
    font-size: 0.875em;
    background: var(--cream-dark);
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
  }

  .article-body :global(pre) {
    background: #1a1a1a;
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    color: #e5e5e5;
    font-size: 1em;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--text-muted);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2rem 0;
  }

  .article-body :global(blockquote p) {
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .article-body :global(blockquote p:not(:last-child)) {
    margin-bottom: 1rem;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 2rem 0;
  }

  .article-body :global(hr) {
    border: none;
    height: 1px;
    background: var(--border-color);
    margin: 3rem 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.625rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .article-body :global(th) {
    font-weight: 600;
  }

  .notch-cover {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: env(safe-area-inset-top, 0px);
    background: var(--cream, #f5f0e8);
    z-index: 1001;
  }

  .progress-bar {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    height: 2px;
    width: 0;
    background: var(--text-primary);
    z-index: 1000;
    transition: width 0.1s linear;
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 1.75rem;
    }

    .article-body {
      font-size: 1rem;
    }

    .article-body :global(h2) {
      font-size: 1.375rem;
    }

    .article-body :global(pre) {
      padding: 1.25rem;
      margin: 1.5rem -1.25rem;
      border-radius: 0;
    }
  }
</style>
