---
// A geodesic sphere (subdivided icosahedron), drawn as flat facets with a single light source.
// Pure geometry, generated at build time.
type V = [number, number, number];
const t = (1 + Math.sqrt(5)) / 2;
const seed: V[] = [
  [-1, t, 0], [1, t, 0], [-1, -t, 0], [1, -t, 0],
  [0, -1, t], [0, 1, t], [0, -1, -t], [0, 1, -t],
  [t, 0, -1], [t, 0, 1], [-t, 0, -1], [-t, 0, 1],
];
let verts: V[] = seed.map((v) => normalize(v));
let faces: [number, number, number][] = [
  [0, 11, 5], [0, 5, 1], [0, 1, 7], [0, 7, 10], [0, 10, 11],
  [1, 5, 9], [5, 11, 4], [11, 10, 2], [10, 7, 6], [7, 1, 8],
  [3, 9, 4], [3, 4, 2], [3, 2, 6], [3, 6, 8], [3, 8, 9],
  [4, 9, 5], [2, 4, 11], [6, 2, 10], [8, 6, 7], [9, 8, 1],
];
function normalize(v: V): V { const l = Math.hypot(...v); return [v[0] / l, v[1] / l, v[2] / l]; }
const cache = new Map<string, number>();
function mid(a: number, b: number) {
  const k = a < b ? `${a}-${b}` : `${b}-${a}`;
  const hit = cache.get(k); if (hit !== undefined) return hit;
  const va = verts[a], vb = verts[b];
  verts.push(normalize([(va[0] + vb[0]) / 2, (va[1] + vb[1]) / 2, (va[2] + vb[2]) / 2]));
  cache.set(k, verts.length - 1); return verts.length - 1;
}
for (let s = 0; s < 2; s++) {
  const next: [number, number, number][] = [];
  for (const [a, b, c] of faces) {
    const ab = mid(a, b), bc = mid(b, c), ca = mid(c, a);
    next.push([a, ab, ca], [b, bc, ab], [c, ca, bc], [ab, bc, ca]);
  }
  faces = next;
}
// Rotate so a vertex is not dead center, then orthographic projection.
const rot = (v: V): V => {
  const ax = 0.42, ay = -0.35;
  let [x, y, z] = v;
  [y, z] = [y * Math.cos(ax) - z * Math.sin(ax), y * Math.sin(ax) + z * Math.cos(ax)];
  [x, z] = [x * Math.cos(ay) + z * Math.sin(ay), -x * Math.sin(ay) + z * Math.cos(ay)];
  return [x, y, z];
};
const R = 190, C = 200;
const light = normalize([-0.5, -0.7, 0.6]);
const polys = faces
  .map((f) => {
    const p = f.map((i) => rot(verts[i]));
    const n = normalize([
      (p[0][0] + p[1][0] + p[2][0]) / 3, (p[0][1] + p[1][1] + p[2][1]) / 3, (p[0][2] + p[1][2] + p[2][2]) / 3,
    ]);
    const shade = Math.max(0, n[0] * light[0] + n[1] * light[1] + n[2] * light[2]);
    const band = Math.min(4, Math.max(0, Math.floor(((n[1] + 1) / 2) * 5)));
    return { z: n[2], shade, band, pts: p.map(([x, y]) => `${(C + x * R).toFixed(1)},${(C - y * R).toFixed(1)}`).join(" ") };
  })
  .filter((p) => p.z > 0)
  .sort((a, b) => a.z - b.z);
---

<svg viewBox="0 0 400 400" class="geo" aria-hidden="true">
  {polys.map((p) => <polygon points={p.pts} class:list={["facet", `b${p.band}`]} style={`--s:${p.shade.toFixed(3)}`} />)}
</svg>

<style>
  .geo { width: 100%; height: auto; display: block; }
  .facet {
    fill: var(--geo-fill);
    fill-opacity: calc(0.08 + var(--s) * 0.34);
    stroke: var(--geo-line);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }
  /* Spectrum bands, bottom to top: magenta, orange, teal, blue, purple */
  .b0 { fill: var(--magenta); } .b1 { fill: var(--orange); } .b2 { fill: var(--teal); } .b3 { fill: var(--blue); } .b4 { fill: var(--purple); }
</style>
