---
// Before / after: one internal queue feeding the GPU vs. twenty independent cuOpt streams with non-overlapping slices.
const cols = 5, rowsN = 4, cell = 18, gap = 5;
const gridW = cols * cell + (cols - 1) * gap;
const gridH = rowsN * cell + (rowsN - 1) * gap;
const boxes = Array.from({ length: cols * rowsN }, (_, k) => ({
  x: (k % cols) * (cell + gap),
  y: Math.floor(k / cols) * (cell + gap),
  d: (k % cols) * 0.18 + Math.floor(k / cols) * 0.07,
}));
---

<div class="diagram">
  <figure class="panel">
    <figcaption><span class="eyebrow">May · one stream at a time</span></figcaption>
    <svg viewBox="0 0 320 104" role="img" aria-label="One internal queue feeding a GPU that spends most of the wall clock waiting.">
      <rect x="10" y="54" width={cell * 2} height={cell} rx="3" class="box one" />
      <text x={10 + cell} y="54" class="lbl" text-anchor="middle" dy="13">1</text>
      <line x1={10 + cell * 2 + 8} y1={54 + cell / 2} x2="196" y2={54 + cell / 2} class="wire" />
      <circle r="3" class="pulse one" cx="0" cy={54 + cell / 2}>
        <animateMotion dur="2.6s" repeatCount="indefinite" path={`M${10 + cell * 2 + 8},0 L196,0`} />
      </circle>
      <rect x="204" y="34" width="104" height="58" rx="4" class="gpu" />
      <text x="256" y="58" class="gpu-l" text-anchor="middle">GPU</text>
      <rect x="216" y="70" width="80" height="8" rx="2" class="util-track" />
      <rect x="216" y="70" width="14" height="8" rx="2" class="util" />
    </svg>
    <p class="cap">HTTP, queue, polling and Python around a mostly idle solver.</p>
  </figure>

  <figure class="panel">
    <figcaption><span class="eyebrow">August · twenty streams, non-overlapping slices</span></figcaption>
    <svg viewBox="0 0 320 104" role="img" aria-label="Twenty independent cuOpt streams feeding the same GPU, which always has the next solve waiting.">
      <g transform="translate(10,8)">
        {boxes.map((b) => <rect x={b.x} y={b.y} width={cell} height={cell} rx="3" class="box many" style={`animation-delay:${b.d}s`} />)}
      </g>
      <line x1={10 + gridW + 8} y1={8 + gridH / 2} x2="196" y2={8 + gridH / 2} class="wire" />
      {[0, 0.6, 1.2].map((d) => (
        <circle r="3" class="pulse" cx="0" cy={8 + gridH / 2}>
          <animateMotion dur="1.8s" begin={`${d}s`} repeatCount="indefinite" path={`M${10 + gridW + 8},0 L196,0`} />
        </circle>
      ))}
      <rect x="204" y="34" width="104" height="58" rx="4" class="gpu" />
      <text x="256" y="58" class="gpu-l" text-anchor="middle">GPU</text>
      <rect x="216" y="70" width="80" height="8" rx="2" class="util-track" />
      <rect x="216" y="70" width="80" height="8" rx="2" class="util accent" />
    </svg>
    <p class="cap">Matrix building, transfer and polling overlap, so the next solve is always waiting.</p>
  </figure>
</div>

<style>
  .diagram { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .panel { display: grid; gap: 10px; padding: 18px; border: 1px solid var(--line); border-radius: 8px; min-width: 0; }
  svg { width: 100%; height: auto; }
  .box { fill: var(--chart-soft); stroke: var(--chart); stroke-width: 1; }
  .box.many { animation: glow 2.4s ease-in-out infinite; }
  @keyframes glow { 0%, 100% { fill: var(--chart-soft); } 50% { fill: var(--chart); } }
  .lbl { font: 500 12px var(--mono); fill: var(--ink); }
  .wire { stroke: var(--line-2); stroke-width: 1.5; }
  .pulse { fill: var(--accent); }
  .pulse.one { fill: var(--chart); }
  .gpu { fill: var(--bg-2); stroke: var(--line-2); }
  .gpu-l { font: 600 13px var(--sans); fill: var(--ink); }
  .util-track { fill: var(--bg-3); }
  .util { fill: var(--chart); }
  .util.accent { fill: var(--accent); }
  .cap { font-size: 13.5px; color: var(--ink-2); }
  @media (max-width: 760px) { .diagram { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .box.many { animation: none; fill: var(--chart); } }
</style>
